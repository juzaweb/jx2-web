# Frontend Environment Variables (Vite)
# Base URL for Giang Ho Backend API service
# Can be direct URL: http://localhost:5000/api or http://localhost:6000/api
# Or relative proxy path: /api
VITE_API_BASE=/api

# Test mode: skills cost no MP and never go on cooldown, and every character
# receives the "Lệnh Bài Test" item, which opens the same GM panel as the GM token.
# Shared by the client and the API server (npm run dev forwards this value to both).
# Accepted truthy values: 1, true, yes, on. Leave empty/false for normal play.
VITE_TEST_MODE=false

# Server-authoritative PK bots. They spawn automatically on combat maps while a
# player is present, patrol, retaliate and cast their starter skill.
# Set BOT_AUTOSPAWN=false to disable automatic spawning (GM panel can still spawn).
BOT_AUTOSPAWN=true
BOT_COUNT=3
BOT_RESPAWN_MS=10000
BOT_LEVEL=30
# BOT_AGGRO_RANGE=1400
# BOT_LEASH_RANGE=2600
# BOT_PATROL_RADIUS=700
